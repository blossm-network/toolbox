{
  "name": "@blossm/blossm",
  "description": "The Blossm codebase.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blossm-network/toolbox.git"
  },
  "author": "blossm.network",
  "bugs": {
    "url": "https://github.com/blossm-network/toolbox/issues"
  },
  "homepage": "https://github.com/blossm-network/toolbox#readme",
  "engines": {
    "node": ">= 24.22.1"
  },
  "scripts": {
    "preversion": "yarn test",
    "version": "auto-changelog && git add CHANGELOG.md",
    "postversion": "git push",
    "bootstrap": "yarn install --frozen-lockfile",
    "test": "yarn test:tooling && lerna run test --concurrency 2",
    "patch": "lerna version patch",
    "minor": "lerna version minor",
    "major": "lerna version major",
    "check-packages": "yarn runtime:check && yarn workspace:check && yarn lint && yarn test",
    "lerna-publish": "lerna publish -y from-package",
    "format": "prettier --write .",
    "runtime:check": "node tools/runtime.js",
    "runtime:sync": "node tools/runtime.js --write",
    "test:runtime": "node --test tools/test/runtime.js",
    "lint": "eslint .",
    "test:lint": "node --test tools/test/lint.js",
    "prepare": "husky",
    "test:tooling": "node --test tools/test/*.js",
    "workspace:check": "node tools/workspaces.js",
    "test:consumer": "node tools/consumer.js"
  },
  "devDependencies": {
    "auto-changelog": "^2.7.0",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "husky": "^9.1.7",
    "lerna": "^10.1.1",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "semver": "^7.8.5"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
